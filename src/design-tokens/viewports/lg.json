{
  "viewport": {
    "start": {
      "$type": "sizing",
      "$value": "{breakpoints.lg}"
    },
    "end": {
      "$type": "sizing",
      "$value": "{breakpoints.xl} - 1px"
    }
  },
  "canvas": {
    "min-width": {
      "$type": "sizing",
      "$value": "{viewport.start}"
    },
    "max-width": {
      "$type": "sizing",
      "$value": "{viewport.end}"
    },
    "default-width": {
      "$type": "sizing",
      "$value": "1650px"
    },
    "min-height": {
      "$type": "sizing",
      "$value": "900px"
    }
  },
  "grid": {
    "spacing": {
      "$type": "spacing",
      "$value": "{gap.md}"
    },
    "px": {
      "$type": "spacing",
      "$value": "{spacing.4}"
    },
    "py": {
      "$type": "spacing",
      "$value": "{spacing.4}"
    }
  }
}