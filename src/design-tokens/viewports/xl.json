{
  "viewport": {
    "start": {
      "$type": "sizing",
      "$value": "{breakpoints.xl}"
    },
    "end": {
      "$type": "sizing",
      "$value": "{breakpoints.2xl} - 1px"
    }
  },
  "canvas": {
    "min-width": {
      "$type": "sizing",
      "$value": "{viewport.start}"
    },
    "max-width": {
      "$type": "sizing",
      "$value": "{viewport.end}"
    },
    "default-width": {
      "$type": "sizing",
      "$value": "1920px"
    },
    "min-height": {
      "$type": "sizing",
      "$value": "1080px"
    }
  },
  "grid": {
    "spacing": {
      "$type": "spacing",
      "$value": "{gap.lg}"
    },
    "px": {
      "$type": "spacing",
      "$value": "{spacing.6}"
    },
    "py": {
      "$type": "spacing",
      "$value": "{spacing.6}"
    }
  }
}